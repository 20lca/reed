[Unit]
Description=REED FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/bonsai/reed/current

# The shared venv provides all runtime deps; the editable install inside it
# points to the current release directory.
ExecStart=/home/bonsai/reed/shared/venv/bin/uvicorn reed.api.main:app \
    --host 127.0.0.1 \
    --port 8765 \
    --root-path /reed

# Keep storage and bw2data projects outside the release tree so they survive deployments
Environment=REED_PATH=/home/bonsai/reed/shared
Environment=STORAGE_ROOT=/home/bonsai/reed/shared/storage
Environment=BRIGHTWAY2_DIR=/home/bonsai/reed/shared/data/brightway
Environment=MPLCONFIGDIR=/home/bonsai/reed/shared/data/matplotlib

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
